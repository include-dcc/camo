Ontology(<http://purl.obolibrary.org/obo/camo/imports/ms_import.owl>
<http://purl.obolibrary.org/obo/camo/releases/2026-08-17/imports/ms_import.owl>
Annotation(<http://purl.org/dc/elements/1.1/source> <http://purl.obolibrary.org/obo/ms/4.1.257/ms.owl>)
Annotation(owl:versionInfo "2026-08-17")

Declaration(Class(<http://purl.obolibrary.org/obo/MS_0000000>))
Declaration(Class(<http://purl.obolibrary.org/obo/MS_1000442>))
Declaration(Class(<http://purl.obolibrary.org/obo/MS_1000499>))
