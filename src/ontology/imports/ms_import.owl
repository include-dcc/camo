SubClassOf(<http://purl.obolibrary.org/obo/MS_1001458> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/MS_0000000>))

# Class: <http://purl.obolibrary.org/obo/MS_1003151> (SHA-256)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MS_1003151> "SHA-256")
SubClassOf(<http://purl.obolibrary.org/obo/MS_1003151> <http://purl.obolibrary.org/obo/MS_1000561>)


