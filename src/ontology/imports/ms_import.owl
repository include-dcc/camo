# Class: <http://purl.obolibrary.org/obo/MS_1000561> (data file checksum type)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MS_1000561> "data file checksum type")

# Class: <http://purl.obolibrary.org/obo/MS_1000568> (MD5)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MS_1000568> "MD5")
